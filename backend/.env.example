NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/cargoflow

# JWT
ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGIN=*

# Cloudflare R2 (S3-compatible) — used for document/photo/signature uploads.
# Leave unset in dev; upload-url endpoints will return a 501 until configured.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# First platform admin, created by `npm run seed:admin` (no public registration route)
SEED_ADMIN_NAME=Platform Admin
SEED_ADMIN_EMAIL=admin@cargoflow.local
SEED_ADMIN_PASSWORD=change-me-now

# Live container tracking (optional — falls back to BIC-prefix carrier
# guessing with no live data if left unset). Each carrier issues its own
# free-registration OAuth2 credentials from its own developer portal.
# Public tracker scrapers are opt-in and intentionally disabled by default.
TRACKING_SCRAPER_ENABLED=false
TRACKING_SCRAPER_TIMEOUT_MS=20000
MSC_TRACKER_URL=https://www.msc.com/en/track-a-shipment

MAERSK_DCSA_CLIENT_ID=
MAERSK_DCSA_CLIENT_SECRET=
MAERSK_DCSA_TOKEN_URL=
MAERSK_DCSA_API_BASE_URL=

CMACGM_DCSA_CLIENT_ID=
CMACGM_DCSA_CLIENT_SECRET=
CMACGM_DCSA_TOKEN_URL=
CMACGM_DCSA_API_BASE_URL=

HAPAG_LLOYD_DCSA_CLIENT_ID=
HAPAG_LLOYD_DCSA_CLIENT_SECRET=
HAPAG_LLOYD_DCSA_TOKEN_URL=
HAPAG_LLOYD_DCSA_API_BASE_URL=
