NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/cargoflow

# JWT
ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Dev only. In production the API refuses to start with * or an empty value: list the web addresses, comma-separated.
CORS_ORIGIN=*

# Number of reverse proxies (nginx, a load balancer, a hosting platform) in front of the API.
# 0 = clients reach the API directly. Set 1 behind one proxy, otherwise every client looks like
# the proxy and the login rate limit (20 tries / 15 min) is shared by everyone.
TRUST_PROXY=0

# Platform-admin dashboard keeps its refresh token in an httpOnly cookie.
# strict = dashboard and API on the same site (e.g. admin.example.com + api.example.com).
# none = they are on different sites (needs HTTPS; CORS_ORIGIN must be the dashboard's exact address).
ADMIN_COOKIE_SAMESITE=strict

# Cloudflare R2 (S3-compatible) — used for document/photo/signature uploads.
# Leave unset in dev; upload-url endpoints will return a 501 until configured.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# First platform admin, created by `npm run seed:admin` (no public registration route)
SEED_ADMIN_NAME=Platform Admin
SEED_ADMIN_EMAIL=admin@cargoflow.local
SEED_ADMIN_PASSWORD=change-me-now

# Live container tracking (optional — falls back to BIC-prefix carrier
# guessing with no live data if left unset). Each carrier issues its own
# free-registration OAuth2 credentials from its own developer portal.
# Background public tracker scrapers are enabled by default. Set to false to disable.
# --- Tracking sources, tried in this order for each carrier; the first that answers wins ---
# 1. The carrier's own API (set that carrier's *_DCSA_* variables; see src/services/tracking/registry.ts).
# 2. MarineTraffic (Kpler) Container Tracking API, a paid carrier-independent backup.
#    Key from sales@kpler.com. Works for any carrier whose SCAC is in src/services/tracking/carrierScac.ts.
MARINETRAFFIC_API_KEY=
# MARINETRAFFIC_API_BASE_URL=https://api.kpler.com/v1/logistics/containers
# 3. Public-page scraper. Maersk, MSC, CMA CGM, and Hapag-Lloyd use their normal
#    public tracking UIs with Playwright. Other carriers need a static HTML result page.
#    Per carrier, in capitals with
#    underscores: SCRAPER_URL_MAERSK, SCRAPER_URL_CMA_CGM, SCRAPER_URL_HAPAG_LLOYD, ...
#    The URL may contain {container}; otherwise the number is added as ?<SCRAPER_PARAM_*>=... (default "container").
#    Install Chromium with `npx playwright install chromium`. UI scrapers are throttled and stop on
#    access challenges; they do not bypass CAPTCHA or other access controls.
TRACKING_SCRAPER_ENABLED=true
# MAERSK_CHROMIUM_EXECUTABLE_PATH=
# MSC_CHROMIUM_EXECUTABLE_PATH=
# MSC_TRACKING_URL=https://www.msc.com/en/track-a-shipment
# CMA_CGM_CHROMIUM_EXECUTABLE_PATH=
# CMA_CGM_TRACKING_URL=https://www.cma-cgm.com/ebusiness/tracking
# HAPAG_LLOYD_CHROMIUM_EXECUTABLE_PATH=
# HAPAG_LLOYD_TRACKING_URL=https://www.hapag-lloyd.com/en/online-business/track/track-by-container-solution.html
TRACKING_SCRAPER_TIMEOUT_MS=20000

MAERSK_DCSA_CLIENT_ID=
MAERSK_DCSA_CLIENT_SECRET=
# Maersk: client id = Consumer Key, secret = Consumer Secret from developer.maersk.com.
# Token URL defaults to https://api.maersk.com/customer-identity/oauth/v2/access_token
MAERSK_DCSA_TOKEN_URL=
MAERSK_DCSA_API_BASE_URL=

CMACGM_DCSA_CLIENT_ID=
CMACGM_DCSA_CLIENT_SECRET=
CMACGM_DCSA_TOKEN_URL=
CMACGM_DCSA_API_BASE_URL=

HAPAG_LLOYD_DCSA_CLIENT_ID=
HAPAG_LLOYD_DCSA_CLIENT_SECRET=
HAPAG_LLOYD_DCSA_TOKEN_URL=
HAPAG_LLOYD_DCSA_API_BASE_URL=

# Client ID card photos (Importer idCardFrontKey/idCardBackKey) are stored under
# the client_id_card/ prefix and only ever read through five-minute signed
# links, but a bucket with a public base URL (R2_PUBLIC_BASE_URL) is readable
# by anyone who knows an object's path. Keep ID cards in a bucket that is NOT
# public, or leave R2_PUBLIC_BASE_URL unset.

# --- Customs verification (Customs / AGL portal) ---
# Approval emails to AGL. Without SMTP_HOST the app records "email not set up"
# on each approval instead of pretending to send, and Customs can resend later.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cargo Flow <no-reply@example.com>"
# Extra recipients for the approval email, besides AGL portal users who have emails switched on.
AGL_NOTIFICATION_EMAILS=
# Public address of the portal, linked from the approval email.
PORTAL_URL=
# The portal is a browser app on its own address: add that address to CORS_ORIGIN (comma-separated).
