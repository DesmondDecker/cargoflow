{
  "expo": {
    "name": "CargoFlow Driver",
    "slug": "cargoflow-driver",
    "scheme": "cargoflow-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": { "backgroundColor": "#0B1F3A" },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.summittechnologies.cargoflow.driver"
    },
    "android": {
      "adaptiveIcon": { "backgroundColor": "#0B1F3A" },
      "package": "com.summittechnologies.cargoflow.driver"
    },
    "plugins": [
      ["expo-image-picker", {
        "cameraPermission": "CargoFlow Driver uses the camera to photograph the delivered container and your driving licence.",
        "photosPermission": "CargoFlow Driver lets you choose a photo of your driving licence."
      }],
      "expo-secure-store",
      "expo-status-bar",
      "expo-notifications",
      ["expo-location", {
        "locationWhenInUsePermission": "CargoFlow Driver records your location when you complete a delivery, as proof of where it was delivered."
      }]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:4000/api/v1",
      "eas": { "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID" }
    }
  }
}
