{
  "expo": {
    "name": "CargoFlow",
    "slug": "cargoflow",
    "scheme": "cargoflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0B1F3A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.summittechnologies.cargoflow"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1F3A"
      },
      "package": "com.summittechnologies.cargoflow"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "CargoFlow uses the camera to scan documents and QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CargoFlow accesses your photos so you can attach scanned or photographed documents to a container."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F5820D"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:4000/api/v1",
      "adMobBannerUnitId": {
        "android": "ca-app-pub-3940256099942544/6300978111",
        "ios": "ca-app-pub-3940256099942544/2934735716"
      },
      "eas": {
        "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
